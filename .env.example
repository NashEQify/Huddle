# Database
DB_USER=huddle
DB_PASSWORD=changeme

# Local development: Prisma connects via localhost (not Docker network)
DATABASE_URL=postgresql://huddle:changeme@localhost:5433/huddle

# LiveKit
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# Client (Vite — baked in at build time)
# LiveKit signaling URL (WebSocket)
# Dev: ws://localhost:7880 (default if not set)
# Prod: wss://your-livekit-domain.com (through reverse proxy/tunnel)
VITE_LIVEKIT_URL=

# LiveKit public URL (runtime — for pre-built Docker images)
# Set this instead of VITE_LIVEKIT_URL when using the standalone docker-compose.
# No rebuild needed — the app fetches this from the server at startup.
# LIVEKIT_PUBLIC_URL=wss://lk.yourdomain.com

# App
SESSION_SECRET=changeme

# Host port override — default is 3000. If you already run something on
# :3000 locally (other docker stacks, dev servers), set this to a free
# port. Only affects the host binding; the container always listens on 3000.
# HUDDLE_APP_PORT=3100

# ── Production only ──────────────────────────────────
# Generate real values:
#   LIVEKIT_API_KEY / LIVEKIT_API_SECRET: any random strings (shared between app + livekit)
#   SESSION_SECRET: openssl rand -hex 32
#   DB_PASSWORD: openssl rand -hex 16
