[
  { "text": "It's dangerous to go alone! Take this.", "attribution": "Old Man, The Legend of Zelda" },
  { "text": "The cake is a lie.", "attribution": "Portal" },
  { "text": "War. War never changes.", "attribution": "Narrator, Fallout" },
  { "text": "Would you kindly?", "attribution": "Atlas, BioShock" },
  { "text": "The right man in the wrong place can make all the difference in the world.", "attribution": "G-Man, Half-Life 2" },
  { "text": "Stay a while and listen.", "attribution": "Deckard Cain, Diablo" },
  { "text": "I used to be an adventurer like you, then I took an arrow in the knee.", "attribution": "Guard, Skyrim" },
  { "text": "Do a barrel roll!", "attribution": "Peppy Hare, Star Fox 64" },
  { "text": "All your base are belong to us.", "attribution": "CATS, Zero Wing" },
  { "text": "Waka waka waka.", "attribution": "Pac-Man" },
  { "text": "It's-a me, Mario!", "attribution": "Mario, Super Mario 64" },
  { "text": "The princess is in another castle.", "attribution": "Toad, Super Mario Bros." },
  { "text": "Thank you Mario! But our princess is in another castle!", "attribution": "Toad, Super Mario Bros." },
  { "text": "Snake? Snake! SNAAAAKE!", "attribution": "Colonel Campbell, Metal Gear Solid" },
  { "text": "A man chooses, a slave obeys.", "attribution": "Andrew Ryan, BioShock" },
  { "text": "Nothing is true, everything is permitted.", "attribution": "Ezio Auditore, Assassin's Creed" },
  { "text": "We all make choices, but in the end our choices make us.", "attribution": "Andrew Ryan, BioShock" },
  { "text": "I need a weapon.", "attribution": "Master Chief, Halo 2" },
  { "text": "Finish him!", "attribution": "Announcer, Mortal Kombat" },
  { "text": "Hadouken!", "attribution": "Ryu, Street Fighter" },
  { "text": "Get over here!", "attribution": "Scorpion, Mortal Kombat" },
  { "text": "You have died of dysentery.", "attribution": "The Oregon Trail" },
  { "text": "Hey! Listen!", "attribution": "Navi, The Legend of Zelda" },
  { "text": "Rise and shine, Mr. Freeman. Rise and shine.", "attribution": "G-Man, Half-Life 2" },
  { "text": "This was a triumph. I'm making a note here: huge success.", "attribution": "GLaDOS, Portal" },
  { "text": "The Enrichment Center reminds you that the Weighted Companion Cube cannot speak.", "attribution": "GLaDOS, Portal" },
  { "text": "Praise the Sun!", "attribution": "Solaire, Dark Souls" },
  { "text": "You Died.", "attribution": "Dark Souls" },
  { "text": "Boy.", "attribution": "Kratos, God of War (2018)" },
  { "text": "Wind's howling.", "attribution": "Geralt, The Witcher 3" },
  { "text": "How about a round of Gwent?", "attribution": "Everyone, The Witcher 3" },
  { "text": "LEEEROYYY JENKINS!", "attribution": "Leeroy Jenkins, World of Warcraft" },
  { "text": "What is a man? A miserable little pile of secrets!", "attribution": "Dracula, Castlevania" },
  { "text": "You were almost a Jill sandwich!", "attribution": "Barry, Resident Evil" },
  { "text": "The truth, Walker, is that you're here because you wanted to feel like something you're not.", "attribution": "Konrad, Spec Ops: The Line" },
  { "text": "Protocol 3: Protect the Pilot.", "attribution": "BT-7274, Titanfall 2" },
  { "text": "I'm Commander Shepard, and this is my favorite store on the Citadel.", "attribution": "Shepard, Mass Effect 2" },
  { "text": "We'll bang, okay?", "attribution": "Shepard (meme), Mass Effect" },
  { "text": "Had to be me. Someone else might have gotten it wrong.", "attribution": "Mordin Solus, Mass Effect 3" },
  { "text": "Kept you waiting, huh?", "attribution": "Solid Snake, Metal Gear Solid" },
  { "text": "You're pretty good.", "attribution": "Revolver Ocelot, Metal Gear Solid 3" },
  { "text": "A Hind D?!", "attribution": "Solid Snake, Metal Gear Solid" },
  { "text": "Nanomachines, son.", "attribution": "Senator Armstrong, MGR: Revengeance" },
  { "text": "I never asked for this.", "attribution": "Adam Jensen, Deus Ex: HR" },
  { "text": "What a shame.", "attribution": "JC Denton, Deus Ex" },
  { "text": "The numbers, Mason! What do they mean?!", "attribution": "Hudson, Call of Duty: Black Ops" },
  { "text": "Remember, no Russian.", "attribution": "Makarov, Call of Duty: MW2" },
  { "text": "Mission failed. We'll get 'em next time.", "attribution": "Captain Price, Call of Duty" },
  { "text": "Ah shit, here we go again.", "attribution": "CJ, GTA: San Andreas" },
  { "text": "All we had to do was follow the damn train, CJ!", "attribution": "Big Smoke, GTA: San Andreas" },
  { "text": "HYAAAH!", "attribution": "Link, The Legend of Zelda" },
  { "text": "The flow of time is always cruel.", "attribution": "Sheik, Zelda: Ocarina of Time" },
  { "text": "You've met with a terrible fate, haven't you?", "attribution": "Mask Salesman, Zelda: Majora's Mask" },
  { "text": "It's super effective!", "attribution": "Narrator, Pokemon" },
  { "text": "A wild MISSINGNO. appeared!", "attribution": "Pokemon Red/Blue (glitch)" },
  { "text": "I see now that the circumstances of one's birth are irrelevant. It is what you do with the gift of life.", "attribution": "Mewtwo, Pokemon" },
  { "text": "You must construct additional pylons.", "attribution": "Protoss Advisor, StarCraft" },
  { "text": "Spawn more Overlords.", "attribution": "Zerg Advisor, StarCraft" },
  { "text": "Not enough minerals.", "attribution": "Advisor, StarCraft" },
  { "text": "Nuclear launch detected.", "attribution": "Advisor, StarCraft" },
  { "text": "My life for Aiur!", "attribution": "Zealot, StarCraft" },
  { "text": "Wololo!", "attribution": "Monk, Age of Empires" },
  { "text": "Prostagma?", "attribution": "Villager, Age of Mythology" },
  { "text": "Job's done.", "attribution": "Peasant, Warcraft III" },
  { "text": "Work, work.", "attribution": "Peon, Warcraft III" },
  { "text": "Ready to work.", "attribution": "Peasant, Warcraft" },
  { "text": "Stop poking me!", "attribution": "Units, Warcraft" },
  { "text": "In the year of darkness, 2029, the rulers of this planet devised the ultimate plan.", "attribution": "Intro, Smash TV" },
  { "text": "Grass grows, birds fly, sun shines, and brother? I hurt people.", "attribution": "Scout, Team Fortress 2" },
  { "text": "Cheers, love! The cavalry's here!", "attribution": "Tracer, Overwatch" },
  { "text": "Heroes never die!", "attribution": "Mercy, Overwatch" },
  { "text": "I've got you in my sights.", "attribution": "Soldier: 76, Overwatch" },
  { "text": "Press F to pay respects.", "attribution": "Call of Duty: Advanced Warfare" },
  { "text": "Do you get to the Cloud District very often? Oh, what am I saying, of course you don't.", "attribution": "Nazeem, Skyrim" },
  { "text": "Let me guess, someone stole your sweetroll.", "attribution": "Guard, Skyrim" },
  { "text": "Hey you, you're finally awake.", "attribution": "Ralof, Skyrim" },
  { "text": "FUS RO DAH!", "attribution": "Dragonborn, Skyrim" },
  { "text": "Never should have come here!", "attribution": "Bandit, Skyrim" },
  { "text": "Whether we wanted it or not, we've stepped into a war with the Cabal on Mars.", "attribution": "Zavala, Destiny 2" },
  { "text": "Eyes up, Guardian.", "attribution": "Ghost, Destiny" },
  { "text": "They're waiting for you, Gordon. In the test chamber.", "attribution": "Scientist, Half-Life" },
  { "text": "Look at you, hacker: a pathetic creature of meat and bone.", "attribution": "SHODAN, System Shock 2" },
  { "text": "I'm looking for sailors.", "attribution": "Ryo Hazuki, Shenmue" },
  { "text": "It's time to kick ass and chew bubblegum, and I'm all out of gum.", "attribution": "Duke Nukem, Duke Nukem 3D" },
  { "text": "The truth is, the game was rigged from the start.", "attribution": "Benny, Fallout: New Vegas" },
  { "text": "Patrolling the Mojave almost makes you wish for a nuclear winter.", "attribution": "NCR Trooper, Fallout: New Vegas" },
  { "text": "Wake up, samurai. We have a city to burn.", "attribution": "Johnny Silverhand, Cyberpunk 2077" },
  { "text": "Endure and survive.", "attribution": "Ellie, The Last of Us" },
  { "text": "I swear.", "attribution": "Joel, The Last of Us" },
  { "text": "A man who never eats pork bun is never a whole man.", "attribution": "Vendor, Sleeping Dogs" },
  { "text": "Rip and tear, until it is done.", "attribution": "King Novik, DOOM Eternal" },
  { "text": "Requiescat in pace.", "attribution": "Ezio Auditore, Assassin's Creed II" },
  { "text": "May the Father of Understanding guide us.", "attribution": "Templars, Assassin's Creed" },
  { "text": "You can't just shoot a hole into the surface of Mars!", "attribution": "Samuel Hayden, DOOM Eternal" },
  { "text": "Hesitation is defeat.", "attribution": "Isshin, Sekiro" },
  { "text": "This is my story.", "attribution": "Tidus, Final Fantasy X" },
  { "text": "Listen to my story. This may be our last chance.", "attribution": "Tidus, Final Fantasy X" },
  { "text": "I am the milkman. My milk is delicious.", "attribution": "Milkman, Psychonauts" },
  { "text": "Don't make a girl a promise if you know you can't keep it.", "attribution": "Cortana, Halo 3" },
  { "text": "Remember us. Remember that we once lived.", "attribution": "Venat, Final Fantasy XIV" },
  { "text": "Every soul has its dark.", "attribution": "Internet, Dark Souls (meme)" },
  { "text": "Dear humanity, we regret being alien bastards. We regret coming to Earth.", "attribution": "Sgt. Johnson, Halo 2" },
  { "text": "Were it so easy.", "attribution": "Arbiter, Halo 3" },
  { "text": "How's your sister?", "attribution": "Cayde-6, Destiny 2" },
  { "text": "The GPS said turn right, so I turned right into the tree. The GPS knows all.", "attribution": "Player, Euro Truck Simulator" },
  { "text": "Grove Street. Home. At least it was before I fucked everything up.", "attribution": "CJ, GTA: San Andreas" },
  { "text": "We're more ghosts than people.", "attribution": "Arthur Morgan, Red Dead 2" },
  { "text": "I gave you all I had.", "attribution": "Arthur Morgan, Red Dead 2" },
  { "text": "Thank you, kind stranger.", "attribution": "Every NPC ever" },
  { "text": "I am Error.", "attribution": "Error, Zelda II" },
  { "text": "You spoony bard!", "attribution": "Tellah, Final Fantasy IV" },
  { "text": "Time is money, friend!", "attribution": "Goblin, World of Warcraft" },
  { "text": "Bravo Six, going dark.", "attribution": "Captain Price, CoD: Modern Warfare" },
  { "text": "A scattered dream that's like a far-off memory. A far-off memory that's like a scattered dream.", "attribution": "Sora, Kingdom Hearts II" },
  { "text": "On days like these, kids like you should be burning in hell.", "attribution": "Sans, Undertale" },
  { "text": "Despite everything, it's still you.", "attribution": "Narrator, Undertale" },
  { "text": "But nobody came.", "attribution": "Narrator, Undertale" },
  { "text": "Just Monika.", "attribution": "Monika, Doki Doki Literature Club" },
  { "text": "The Stanley Parable is a game about choice.", "attribution": "Narrator, The Stanley Parable" },
  { "text": "I'm really feeling it!", "attribution": "Shulk, Xenoblade Chronicles" },
  { "text": "Prepare to die.", "attribution": "Dark Souls" },
  { "text": "You are dead. Dead. Dead.", "attribution": "Total Distortion" },
  { "text": "No Gods or Kings. Only Man.", "attribution": "Banner, BioShock" },
  { "text": "Hmm.", "attribution": "Geralt, The Witcher 3" },
  { "text": "JASON! JAAASON!", "attribution": "Ethan Mars, Heavy Rain" },
  { "text": "Time to split!", "attribution": "Cortez, TimeSplitters 2" },
  { "text": "Catch-a-ride!", "attribution": "Scooter, Borderlands" },
  { "text": "They asked me how well I understood theoretical physics. I said I had a theoretical degree in physics.", "attribution": "Fantastic, Fallout: New Vegas" },
  { "text": "Another settlement needs your help.", "attribution": "Preston Garvey, Fallout 4" },
  { "text": "The right choice is the one you can live with.", "attribution": "Commander Shepard, Mass Effect" },
  { "text": "Ah yes, 'Reapers'. We have dismissed that claim.", "attribution": "Councillor, Mass Effect" }
]
